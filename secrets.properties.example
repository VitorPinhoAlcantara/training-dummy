# Copy this file to secrets.properties (gitignored, never committed) and fill in real values.
# These become the mod's built-in fallback worker credentials (com.trainingdummy.config.CommonConfig),
# used whenever a server admin leaves modpackId/workerApiKey/workerBaseUrl blank in their own
# trainingdummy-common.toml. Missing keys default to an empty string (or, for the base URL, the
# public worker), so the build still succeeds without this file - the worker features just fall
# back to "unconfigured" until you add it.

worker_default_modpack_id=
worker_default_modpack_api_key=
worker_default_base_url=https://dummyscoreboard-worker.vitoralcantara1722.workers.dev
